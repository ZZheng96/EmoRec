      "subwindows": 5,
      "seconds_per_window": 2,
      "statistics": [
        "mean",
        "std",
        "slope"
      ],
      "n_features": 450
    },
    "metrics": {
      "primary": "pooled out-of-fold trial-level ROC AUC",
      "secondary": [
        "binary F1",
        "balanced accuracy"
