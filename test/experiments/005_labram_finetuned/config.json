{
  "experiment_id": "005_labram_finetuned",
  "reuse_config": "../004_labram_frozen/config.json",
  "random_seed": 2026,
  "training": {
    "epochs": 5,
    "batch_size": 8,
    "backbone_lr": 0.00001,
    "head_lr": 0.0001,
