    "outer_validation_early_stopping": false,
    "hyperparameter_tuning": false,
    "final_seed": 2031
  },
  "protocol": {
    "fold_source": "002_subject_normalization/predictions/subject_zscore_exclude_hc43_oof.csv",
    "n_subjects": 69,
    "n_samples": 2760,
    "excluded_subject": "HC43",
    "conditions": ["raw", "subject_zscore"],
    "normalization": "Label-free within-subject zscore of logit_positive minus logit_negative followed by sigmoid; 40 OOF segments or 8 public trials per subject",
    "public_labels_used": false
  }
